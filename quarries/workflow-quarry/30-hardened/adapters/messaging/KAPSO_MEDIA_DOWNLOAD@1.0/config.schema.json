{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation://adapters/messaging/kapso-media-download/1.0/config",
  "title": "KAPSO_MEDIA_DOWNLOAD@1.0 configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiBaseUrl": {
      "type": "string",
      "format": "uri",
      "default": "https://api.kapso.ai/meta/whatsapp/v24.0"
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800,
      "default": 10485760
    },
    "allowedDownloadHost": {
      "type": "string",
      "const": "api.kapso.ai"
    }
  },
  "required": ["apiBaseUrl", "maxBytes", "allowedDownloadHost"]
}
