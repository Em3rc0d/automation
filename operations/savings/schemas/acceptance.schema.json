{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SavingsInstallationAcceptance",
  "type": "object",
  "required": [
    "schemaVersion",
    "checks",
    "notes",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checks": {
      "type": "object",
      "required": [
        "configReviewed",
        "connectorScopesVerified",
        "baselineAgreed",
        "costPolicyAccepted",
        "rollbackReviewed",
        "productionDryRunPassed",
        "clientFixturePassed",
        "clientApprovalRecorded"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "object",
      "required": [
        "productionDryRunPassed",
        "clientFixturePassed",
        "clientApprovalRecorded"
      ],
      "properties": {
        "productionDryRunPassed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidenceRef"
            }
          ]
        },
        "clientFixturePassed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidenceRef"
            }
          ]
        },
        "clientApprovalRecorded": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidenceRef"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": [
        "entryId",
        "sha256",
        "snapshot",
        "actor",
        "recordedAt"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
