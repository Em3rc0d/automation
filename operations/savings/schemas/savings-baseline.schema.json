{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallationSavingsBaseline",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflowKey",
    "unit",
    "status",
    "currency"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowKey": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "AGREED"
      ]
    },
    "manual_minutes_per_unit": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "baseline_sample_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "baseline_method": {
      "enum": [
        "time_study",
        "system_data",
        "client_declared",
        "mixed",
        null
      ]
    },
    "loaded_hourly_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        null
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agreedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
