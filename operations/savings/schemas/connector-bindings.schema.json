{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SavingsConnectorBindings",
  "type": "object",
  "required": [
    "schemaVersion",
    "secretPolicy",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "secretPolicy": {
      "const": "REFERENCES_ONLY"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "adapterRole",
          "provider",
          "credentialRef",
          "scopes",
          "status"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "adapterRole": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "credentialRef": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^credref:"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "unbound",
              "verified",
              "degraded",
              "revoked"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
