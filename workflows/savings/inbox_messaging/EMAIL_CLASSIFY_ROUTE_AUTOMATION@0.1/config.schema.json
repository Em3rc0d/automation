{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMAIL_CLASSIFY_ROUTE_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "defaultQueue": {
      "type": "string",
      "default": "general"
    }
  },
  "additionalProperties": false
}
