{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMAIL_ATTACHMENT_EXTRACT_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "allowedMimeTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 10000000
    },
    "prefix": {
      "type": "string",
      "default": "email-attachments"
    }
  },
  "additionalProperties": false
}
