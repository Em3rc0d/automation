{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UNANSWERED_MESSAGE_WATCHDOG_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "slaHours": {
      "type": "number",
      "minimum": 0.1,
      "default": 4
    },
    "missingOwnerExceptionMinutes": {
      "type": "number",
      "minimum": 0,
      "default": 2
    },
    "defaultChannel": {
      "enum": [
        "email",
        "whatsapp",
        "sms"
      ],
      "default": "email"
    },
    "templateKey": {
      "type": "string",
      "default": "unanswered-message-alert-v1"
    }
  },
  "additionalProperties": false
}
