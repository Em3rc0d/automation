{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOW_STOCK_ALERT_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "missingContactExceptionMinutes": {
      "type": "number",
      "minimum": 0,
      "default": 2
    },
    "defaultChannel": {
      "enum": [
        "email",
        "whatsapp",
        "sms"
      ],
      "default": "email"
    },
    "templateKey": {
      "type": "string",
      "default": "low-stock-alert-v1"
    },
    "alertContact": {
      "type": [
        "object",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false
}
