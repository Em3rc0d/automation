{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RENEWAL_REMINDER_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "reminderOffsetsDays": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        30,
        7,
        0
      ]
    },
    "missingContactExceptionMinutes": {
      "type": "number",
      "minimum": 0,
      "default": 3
    },
    "defaultChannel": {
      "enum": [
        "email",
        "whatsapp",
        "sms"
      ],
      "default": "email"
    },
    "templateKey": {
      "type": "string",
      "default": "renewal-reminder-v1"
    }
  },
  "additionalProperties": false
}
