{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAD_INTAKE_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "acceptedSourceSystems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": false
}
