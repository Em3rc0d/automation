{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAD_FOLLOWUP_AUTOMATION output",
  "type": "object",
  "required": ["scannedLeads", "eligible", "executions"],
  "properties": {
    "scannedLeads": { "type": "integer", "minimum": 0 },
    "eligible": { "type": "integer", "minimum": 0 },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["leadId", "stage", "status"],
        "properties": {
          "leadId": { "type": "string" },
          "stage": { "type": "string" },
          "status": { "enum": ["completed", "attention_required", "failed", "skipped_duplicate"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
