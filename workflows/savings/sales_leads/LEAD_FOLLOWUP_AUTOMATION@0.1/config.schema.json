{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAD_FOLLOWUP_AUTOMATION tenant configuration",
  "type": "object",
  "required": ["enabled", "dryRun", "businessTimezone", "stages", "minSpacingHours"],
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "dryRun": { "type": "boolean", "default": true },
    "businessTimezone": { "type": "string", "default": "America/Lima" },
    "schedule": { "type": "string", "default": "0 * * * *" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "delayHours", "templateKey"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "delayHours": { "type": "number", "minimum": 0, "maximum": 8760 },
          "templateKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "default": [
        { "key": "h24", "delayHours": 24, "templateKey": "lead-followup-24h-v1" },
        { "key": "h72", "delayHours": 72, "templateKey": "lead-followup-72h-v1" },
        { "key": "h168", "delayHours": 168, "templateKey": "lead-followup-7d-v1" }
      ]
    },
    "minSpacingHours": { "type": "number", "minimum": 0, "maximum": 720, "default": 12 },
    "missingContactExceptionMinutes": { "type": "number", "minimum": 0, "maximum": 120, "default": 3 },
    "defaultChannel": { "enum": ["email", "whatsapp", "sms"], "default": "email" },
    "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
    "providerCostPolicy": {
      "enum": ["CLIENT_OWNED_OR_METERED", "INCLUDED_WITH_QUOTA", "EXPLICIT_EXCEPTION"],
      "default": "CLIENT_OWNED_OR_METERED"
    }
  },
  "additionalProperties": false
}
