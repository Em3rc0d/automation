{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUOTE_FOLLOWUP_AUTOMATION tenant configuration",
  "type": "object",
  "required": [
    "enabled",
    "dryRun",
    "businessTimezone"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "dryRun": {
      "type": "boolean",
      "default": true
    },
    "businessTimezone": {
      "type": "string",
      "default": "America/Lima"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [
        {
          "key": "d2",
          "delayDays": 2,
          "templateKey": "quote-followup-2d-v1"
        },
        {
          "key": "d5",
          "delayDays": 5,
          "templateKey": "quote-followup-5d-v1"
        }
      ]
    },
    "minSpacingHours": {
      "type": "number",
      "minimum": 0,
      "default": 12
    },
    "missingContactExceptionMinutes": {
      "type": "number",
      "minimum": 0,
      "default": 3
    }
  },
  "additionalProperties": false
}
