{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAYMENT_REMINDER_AUTOMATION tenant configuration",
  "description": "Reference configuration for scheduled payment reminders. Provider credentials remain external connector bindings.",
  "type": "object",
  "required": ["enabled", "dryRun", "businessTimezone", "reminderOffsetsDays", "defaultChannel", "templateKey"],
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "dryRun": { "type": "boolean", "default": true },
    "businessTimezone": { "type": "string", "default": "America/Lima" },
    "schedule": { "type": "string", "default": "0 8 * * *", "description": "Tenant-local scheduler expression; runtime binding decides scheduler implementation." },
    "reminderOffsetsDays": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": -90, "maximum": 365 },
      "default": [-3, 0, 7, 15],
      "description": "Negative = before due date, zero = due date, positive = overdue days."
    },
    "missingContactExceptionMinutes": { "type": "number", "minimum": 0, "maximum": 120, "default": 2 },
    "defaultChannel": { "enum": ["email", "whatsapp", "sms"], "default": "email" },
    "templateKey": { "type": "string", "minLength": 1, "default": "payment-reminder-v1" },
    "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
    "providerCostPolicy": {
      "enum": ["CLIENT_OWNED_OR_METERED", "INCLUDED_WITH_QUOTA", "EXPLICIT_EXCEPTION"],
      "default": "CLIENT_OWNED_OR_METERED"
    }
  },
  "additionalProperties": false
}
