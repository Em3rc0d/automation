{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAYMENT_REMINDER_AUTOMATION batch output",
  "type": "object",
  "required": ["scanned", "eligible", "executions"],
  "properties": {
    "scanned": { "type": "integer", "minimum": 0 },
    "eligible": { "type": "integer", "minimum": 0 },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invoiceId", "offsetDays", "status"],
        "properties": {
          "invoiceId": { "type": "string" },
          "offsetDays": { "type": "integer" },
          "status": { "enum": ["completed", "attention_required", "failed", "skipped_duplicate"] },
          "duplicate": { "type": "boolean" },
          "runId": { "type": ["string", "null"] },
          "traceId": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
