{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APPOINTMENT_REMINDER_AUTOMATION tenant configuration",
  "type": "object",
  "required": ["enabled", "dryRun", "businessTimezone", "reminderOffsetsMinutes", "scanWindowMinutes"],
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "dryRun": { "type": "boolean", "default": true },
    "businessTimezone": { "type": "string", "default": "America/Lima" },
    "schedule": { "type": "string", "default": "*/30 * * * *" },
    "reminderOffsetsMinutes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 10080 },
      "default": [1440, 120]
    },
    "scanWindowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 30 },
    "missingContactExceptionMinutes": { "type": "number", "minimum": 0, "maximum": 120, "default": 2 },
    "defaultChannel": { "enum": ["email", "whatsapp", "sms"], "default": "email" },
    "templateKey": { "type": "string", "minLength": 1, "default": "appointment-reminder-v1" },
    "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
    "providerCostPolicy": {
      "enum": ["CLIENT_OWNED_OR_METERED", "INCLUDED_WITH_QUOTA", "EXPLICIT_EXCEPTION"],
      "default": "CLIENT_OWNED_OR_METERED"
    }
  },
  "additionalProperties": false
}
