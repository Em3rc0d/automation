{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APPOINTMENT_REMINDER_AUTOMATION output",
  "type": "object",
  "required": ["scannedEvents", "eligible", "executions"],
  "properties": {
    "scannedEvents": { "type": "integer", "minimum": 0 },
    "eligible": { "type": "integer", "minimum": 0 },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["appointmentId", "attendeeId", "stageMinutes", "status"],
        "properties": {
          "appointmentId": { "type": "string" },
          "attendeeId": { "type": "string" },
          "stageMinutes": { "type": "integer" },
          "status": { "enum": ["completed", "attention_required", "failed", "skipped_duplicate"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
