# CASE-001 local PoC. This is not the final/production configuration.
CASE001_MODE=poc
CASE001_AI_PROVIDER=gemini
CASE001_MESSAGING_PROVIDER=local
CASE001_ADMIN_TOKEN=case001-local-only
CASE001_TENANT_ID=case-001-pilot
CASE001_SELLER_PHONE=

# PostgreSQL local. Docker Compose overrides this host with db:5432 inside the app container.
DATABASE_URL=postgresql://case001:case001@localhost:5432/case001
CASE001_DB_POOL_MAX=10

# Gemini is the only external service required for the default PoC semantic path.
# Keep the real value only in your local .env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase cloud adapter is intentionally not required by the local PoC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kapso is intentionally not required by the local PoC. Local messaging is simulated.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_SEND_MESSAGE_URL=

# Engineering policy defaults only. Replace with client-confirmed rules before a real pilot.
DEFAULT_CURRENCY=USD
IGV_RATE=0.18
MAX_AUTO_DISCOUNT_PCT=8
MINIMUM_MARGIN_PCT=22
QUOTE_VALIDITY_DAYS=7
SAP_STALE_AFTER_HOURS=24
CASE001_FIXED_FX_RATE=

FOLLOWUP_AFTER_HOURS=12
FOLLOWUP_MAX_ATTEMPTS=1
