# Runtime mode
CASE001_MODE=mock
CASE001_ADMIN_TOKEN=change-me
CASE001_TENANT_ID=case-001-pilot
CASE001_SELLER_PHONE=

# Supabase (required for live mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (client-owned key; required for live semantic extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kapso (required for live WhatsApp send/receive)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Keep provider endpoint configurable until bound against the client's Kapso workspace.
KAPSO_SEND_MESSAGE_URL=

# Commercial defaults - replaced by tenant policy before production
DEFAULT_CURRENCY=USD
IGV_RATE=0.18
MAX_AUTO_DISCOUNT_PCT=8
MINIMUM_MARGIN_PCT=22
QUOTE_VALIDITY_DAYS=7
SAP_STALE_AFTER_HOURS=24
# Temporary staging-only FX fallback. Replace with authoritative rate adapter before production.
CASE001_FIXED_FX_RATE=

# Follow-up policy. Free-form WhatsApp follow-up is intentionally blocked after 24h;
# a provider template adapter must be configured for messages outside the service window.
FOLLOWUP_AFTER_HOURS=12
