# Runtime mode
CASE001_MODE=mock
CASE001_ADMIN_TOKEN=change-me
CASE001_TENANT_ID=case-001-pilot
CASE001_SELLER_PHONE=

# Supabase (required for database-backed staging/live mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (client-owned key; required for live semantic extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kapso (required for live WhatsApp send/receive)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Keep provider endpoint configurable until bound against the client's Kapso workspace/current contract.
KAPSO_SEND_MESSAGE_URL=

# Commercial defaults - engineering fixtures only; replace with client-confirmed policy
DEFAULT_CURRENCY=USD
IGV_RATE=0.18
MAX_AUTO_DISCOUNT_PCT=8
MINIMUM_MARGIN_PCT=22
QUOTE_VALIDITY_DAYS=7
SAP_STALE_AFTER_HOURS=24
CASE001_FIXED_FX_RATE=

# Follow-up policy
FOLLOWUP_AFTER_HOURS=12
FOLLOWUP_MAX_ATTEMPTS=1
