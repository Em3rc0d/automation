{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.local/case-002/conversation-response-plan.schema.json",
  "title": "CASE-002 Conversation Response Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "fallbackText",
    "protectedFacts",
    "forbiddenTerms"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "fallbackText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "protectedFacts": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "forbiddenTerms": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true
    }
  }
}
