{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.local/schemas/case-002/triage-decision.schema.json",
  "title": "CASE-002 OperationalTriageDecision",
  "description": "Operational routing decision, not a mechanical diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serviceRequestId",
    "route",
    "reasons",
    "mechanicalDiagnosisProduced"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "serviceRequestId": { "type": "string", "minLength": 1 },
    "route": { "enum": ["collect_more_information", "request_evidence", "human_review", "appointment", "roadside_human_escalation", "close_duplicate"] },
    "reasons": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 500 } },
    "requiredMissingFields": { "type": "array", "items": { "type": "string" } },
    "appointmentIntent": { "type": ["string", "null"], "enum": ["diagnostic", "maintenance", "inspection", "repair_intake", null] },
    "humanReviewType": { "type": ["string", "null"], "enum": ["warranty", "urgent_safety_uncertainty", "roadside_dispatch", "ambiguous_request", "evidence_uncertain", "other", null] },
    "mechanicalDiagnosisProduced": { "const": false }
  }
}
