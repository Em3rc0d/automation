# CASE-002 portable n8n runtime
# Copy to .env and replace every CHANGE_ME value.
# Never commit the resulting .env.

N8N_PUBLIC_PORT=5678
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_SECRET

TZ=America/Lima
GENERIC_TIMEZONE=America/Lima
N8N_USER_FOLDER=/home/node
DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite

# Current PoC provider configuration
KAPSO_META_API_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
CASE002_GEMINI_MODEL=models/gemini-2.5-flash

# Bootstrap flags. These are one-shot / migration controls, not permanent runtime modes.
CASE002_IMPORT_WORKFLOWS_ON_STARTUP=true
CASE002_LEVEL2_REPLY_TEST_ON_STARTUP=false
CASE002_LEVEL2_APPOINTMENT_AGENT_ON_STARTUP=false
CASE002_LEVEL2_GEMINI_POC_ON_STARTUP=false
CASE002_RECOVER_WORKFLOWS=false

# Backups
CASE002_BACKUP_REQUIRED=true
CASE002_BACKUP_RETENTION=20
