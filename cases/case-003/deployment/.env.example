# CASE-003 portable n8n deployment.
# Copy to .env, chmod 600, fill locally. Never commit .env.

N8N_VERSION=2.38.7
N8N_FQDN=n8n.example.com
N8N_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# n8n internal PostgreSQL only.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_DB_SECRET
N8N_DB_SCHEMA=public

GENERIC_TIMEZONE=America/Lima
EXECUTIONS_DATA_MAX_AGE=336

# CASE-003 business/control plane.
CASE003_SUPABASE_URL=https://PROJECT_REF.supabase.co
CASE003_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Keep RPC/provider/mail secrets in n8n credentials or a secret manager.
# Never put live secrets in this example.
