# Non-secret/reference variables
N8N_VERSION=2.38.7
N8N_USER_FOLDER=/home/node
PORT=5678
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Secret: create in Railway, never commit the value.
N8N_ENCRYPTION_KEY=SECRET

# Greenfield n8n PostgreSQL. Prefer Railway references/private networking.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=REFERENCE_OR_PRIVATE_HOST
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=SECRET_OR_REFERENCE
DB_POSTGRESDB_PASSWORD=SECRET_OR_REFERENCE
DB_POSTGRESDB_SCHEMA=public

# CASE-003 business/control plane
CASE003_SUPABASE_URL=https://PROJECT_REF.supabase.co
CASE003_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# One-shot flags must remain false outside an explicitly approved operation.
CASE003_SMTP_NETWORK_PROBE_ON_STARTUP=false
CASE003_GATE10_SMTP_TEST_ON_STARTUP=false
CASE003_GATE10_SCRUB_ON_STARTUP=false
