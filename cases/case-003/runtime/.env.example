# CASE-003 local/VPS example. Never commit real secrets.
POSTGRES_DB=case003
POSTGRES_USER=case003
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima

# Gate-1 local baseline for a brand-new n8n volume.
CASE003_EXPECTED_PRE_WORKFLOWS=0
CASE003_EXPECTED_PRE_CREDENTIALS=0

# Gate-2 Supabase RPC adapter. Use placeholders here; real values belong in runtime secrets.
CASE003_SUPABASE_URL=https://your-project-ref.supabase.co
CASE003_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
CASE003_RPC_TOKEN=replace-with-a-long-random-secret

# Portable smoke fixture IDs.
CASE003_EXPECTED_SMOKE_TENANT_ID=30000000-0000-0000-0000-000000000000
CASE003_EXPECTED_SMOKE_INVOICE_ID=30000000-0000-0000-0000-000000000100
