# CASE-003 local/VPS example. Never commit real secrets.
POSTGRES_DB=case003
POSTGRES_USER=case003
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima

# Gate-1 local baseline for a brand-new n8n volume.
CASE003_EXPECTED_PRE_WORKFLOWS=0
CASE003_EXPECTED_PRE_CREDENTIALS=0

# Gate-2 direct PostgreSQL adapter. Defaults target the Compose postgres service.
CASE003_PG_HOST=postgres
CASE003_PG_DATABASE=case003
CASE003_PG_USER=case003
CASE003_PG_PASSWORD=change-me
CASE003_PG_PORT=5432
CASE003_PG_SSL=disable

# Gate-2 Supabase RPC adapter. Use placeholders here; real values belong in runtime secrets.
CASE003_SUPABASE_URL=https://your-project-ref.supabase.co
CASE003_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
CASE003_RPC_TOKEN=replace-with-a-long-random-secret

# Gate-3 reservation rule. Use a distinct probe code for repeatable certification in a shared test DB.
CASE003_RULE_CODE=due_3d

# Portable smoke fixture IDs.
CASE003_EXPECTED_SMOKE_TENANT_ID=30000000-0000-0000-0000-000000000000
CASE003_EXPECTED_SMOKE_INVOICE_ID=30000000-0000-0000-0000-000000000100

# Gate-5 access-control smoke target. Defaults match the bundled local synthetic snapshot.
CASE003_GATE5_TENANT_ID=30000000-0000-0000-0000-000000000000
CASE003_GATE5_INVOICE_REFERENCE=F001-100
CASE003_GATE5_COMPANY_CODE=PE10
CASE003_GATE5_FI_DOCUMENT=5100000100
CASE003_GATE5_SNAPSHOT_ID=30000000-0000-0000-0000-000000000001

# Gate-6 channel-ingress smoke target. Synthetic defaults only.
CASE003_GATE6_TENANT_ID=30000000-0000-0000-0000-000000000000
CASE003_GATE6_INVOICE_REFERENCE=F001-100
CASE003_GATE6_TAX_ID=20000000001
CASE003_GATE6_VERIFIED_SUBJECT=gate6-whatsapp-authorized-v1

# Gate-7 Kapso provider-ingress smoke configuration. Synthetic defaults only.
# Reuse an existing n8n Crypto credential ID when available, or provide a test
# webhook secret directly for a fresh local/VPS certification environment.
CASE003_KAPSO_HMAC_CREDENTIAL_ID=
CASE003_KAPSO_HMAC_CREDENTIAL_NAME=CASE003 Kapso HMAC
CASE003_KAPSO_WEBHOOK_SECRET=
CASE003_GATE7_PHONE_NUMBER_ID=999000111222333
CASE003_GATE7_VERIFIED_SENDER=51999900001
CASE003_GATE7_UNKNOWN_SENDER=51999900002
CASE003_GATE7_INVOICE_REFERENCE=F001-100
